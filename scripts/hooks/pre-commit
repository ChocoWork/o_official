#!/bin/sh
#
# コミット時の速いゲート。数秒で終わる範囲だけを見る。
# 重い検証（ユニット全件・E2E 全件）は pre-push が担当する。
#
set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' | tr '\n' ' ')

if [ -z "$STAGED" ]; then
  exit 0
fi

echo "[pre-commit] lint（ステージ済みファイル）"
npx eslint $STAGED

# tsconfig は src / e2e / tests をまとめて見るので、型は全体で確認するしかない。
# 実測 3 秒程度なので毎回走らせて問題ない。
echo "[pre-commit] typecheck"
npm run --silent typecheck

echo "[pre-commit] 関連ユニットテスト"
# 速さを測るテストは並列の負荷で揺れるので、並列の実行から外し、関係する時だけ1本ずつ流す。
# CLI の除外指定は設定を置き換えるため、既存の除外も残す。先頭が / の引数は sh が書き換えるので [/] と書く。
npx jest --findRelatedTests $STAGED --passWithNoTests --silent --testPathIgnorePatterns '[/]node_modules[/]' '<rootDir>/.claude/' 'tests/unit/lib/discounts/discount-search[.]test[.]ts$' 'tests/items/items-api[.]performance[.]test[.]ts$'
RELATED=$(npx jest --listTests --findRelatedTests $STAGED)
TIMING=$(printf '%s\n' "$RELATED" | grep -E 'tests[\/]unit[\/]lib[\/]discounts[\/]discount-search[.]test[.]ts$|tests[\/]items[\/]items-api[.]performance[.]test[.]ts$' || true)
if [ -n "$TIMING" ]; then
  echo "[pre-commit] 関連する速さを測るテスト（1本ずつ実行）"
  npx jest --silent --runInBand --runTestsByPath $TIMING
fi

echo "[pre-commit] OK"
