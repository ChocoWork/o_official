# Meta KPI integration (server-side only)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
META_REDIRECT_URI=http://localhost:3000/api/admin/kpi/meta/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_TOKEN_ENCRYPTION_KEY=
# 定期処理の入口（worker・見回り・照合・Meta の同期）の合言葉。32文字以上のランダムな値（短いと全部断る）
CRON_SECRET=
# Public site origin, for example https://example.com (no trailing slash).
# Embedded at build time. In the Vercel Production environment this and NEXT_PUBLIC_SUPABASE_URL
# MUST be set BEFORE the build; otherwise the production build fails (next.config.ts, SEC-ABOUT-007).
NEXT_PUBLIC_SITE_URL=
# Supabase project URL, for example https://<project-ref>.supabase.co (no trailing slash).
# Embedded at build time. If SUPABASE_URL is also set it must point at the same origin, or the build fails.
NEXT_PUBLIC_SUPABASE_URL=
# Origins allowed to send state-changing requests (comma separated, no trailing slash), for example https://example.com
# In the Vercel Production environment this MUST be set BEFORE the build; otherwise the production build fails (SEC-ABOUT-007-AC-02).
APP_ALLOWED_ORIGINS=
# Public application origin, for example https://example.com (no trailing slash)
APP_BASE_URL=
# Stripe signs POST ${APP_BASE_URL}/api/webhook/stripe with this secret
STRIPE_WEBHOOK_SECRET=
# Resend の配達の知らせの署名を確かめる合言葉（送信の API キーとは別）
RESEND_DELIVERY_WEBHOOK_SECRET=
# 支払いの要対応を知らせる店のアドレス（src/lib/orders/order-lifecycle-emails.ts）
SHOP_ALERT_EMAIL=

# Legal archive automation (server-side / GitHub Actions only)
LEGAL_ARCHIVE_CRON_SECRET=
LEGAL_ARCHIVE_DATABASE_DUMP=
SUPABASE_DB_URL=
# Optional second private object-storage target (S3 compatible)
S3_ARCHIVE_BUCKET=
S3_ARCHIVE_REGION=
S3_ARCHIVE_ENDPOINT=
S3_ARCHIVE_FORCE_PATH_STYLE=false
# Default retention is 7 years. Set a fiscal-year-specific override to 10 where required.
# LEGAL_ARCHIVE_RETENTION_YEARS_2026=10

# Cloudflare Turnstile (bot protection for login / register / password-reset / contact)
# Production: REQUIRED. Unset in production build -> API returns 403 "Bot detection failed".
# Local dev: use the official always-pass test keys below.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 配送の追跡をオンにする時だけ必要（サーバー専用）。
# TRACKING_17TRACK_BASE_URL は空なら 17TRACK の本番の住所（https://api.17track.net/track/v2.4）を使う。
# 手元の試しでは作り物の住所を E2E が入れる。
TRACKING_17TRACK_API_KEY=
TRACKING_17TRACK_BASE_URL=
# 注文状況の確認印に使うサーバー専用の鍵。空なら JWT_SECRET を使う。
ORDER_STATUS_SESSION_SECRET=

# 送り元の IP を x-vercel-forwarded-for / x-real-ip から読んでよいことを示す旗（値は見ない。ADR-0416）。
# E2E 専用: scripts/e2e/environment.ts が手元の Supabase の時だけ x-real-ip を入れる。ここに置かない・本番に置かない。
# 本番の Vercel は VERCEL=1 が自動で入るので不要。Vercel 以外に置く時の約束は docs/06_Operations/secrets.md の CLIENT_IP_HEADER を読む。
# CLIENT_IP_HEADER=

# アプリのログイン（パスワード → メール OTP → 必要なら TOTP）を通って自前の sessions に結び付いた session だけを受ける旗（ADR-0419）。
# off・0・false（大小文字を区別しない）の時だけ無効。未設定・空・その他は有効（既定）。無効にするのは段階の切替えと緊急の時だけ。
# 本番では設定しない。E2E は scripts/e2e/environment.ts が on に固定する。詳しくは docs/06_Operations/secrets.md の AUTH_REQUIRE_APP_SESSION を読む。
# AUTH_REQUIRE_APP_SESSION=
